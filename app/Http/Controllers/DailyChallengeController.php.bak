    'user_answer' => 'Wrong answer',
    'correct_answer' => 'Correct answer',
    'created_at' => now(),
    'updated_at' => now(),
]);


catch (\Exception $e) {
            return response()->json(['success' => false, 'message' => $e->getMessage()]);
        }
    }
}